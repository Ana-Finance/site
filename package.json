{
  "name": "ana-finance-site",
  "private": true,
  "type": "module",
  "scripts": {
    "cms:annotate": "node scripts/cms-annotate.mjs",
    "cms:seed": "node scripts/cms-seed.mjs",
    "cms:rekey": "node scripts/cms-rekey.mjs",
    "build:admin": "vite build --config admin-app/vite.config.ts",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run build:admin && npm run build:site",
    "dev:admin": "vite --config admin-app/vite.config.ts",
    "check": "node scripts/check-site.mjs",
    "typecheck": "tsc -p admin-app/tsconfig.json --noEmit",
    "lint": "eslint admin-app/src cms scripts tests supabase/functions",
    "test": "vitest run",
    "test:sql": "bash supabase/tests/run.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.69.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1"
  }
}
