# Variables PUBLIQUES de l'administration (compilées dans le JavaScript, protégées par la RLS).
# En CI : Settings → Secrets and variables → Actions → Variables.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...   # clé « anon » / publishable — JAMAIS la service_role

# Les secrets ne vont PAS ici. Voir docs/SETUP.md :
#   Supabase (Edge Functions) : GITHUB_TOKEN, GITHUB_REPOSITORY, CMS_BUILD_TOKEN, PLAUSIBLE_API_KEY, ADMIN_URL, SITE_URL, ALLOWED_ORIGINS
#   GitHub Actions (secrets)  : CMS_BUILD_TOKEN ; (variables) CMS_EXPORT_URL, SITE_URL
